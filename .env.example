# ════════════════════════════════════════════════════════════════════════════
#  ЗАЯВКИ С САЙТА
# ════════════════════════════════════════════════════════════════════════════
# Два рабочих режима. Переключается одной строкой.

# ── Режим 1: web3forms (работает на статическом хостинге) ───────────────────
# Сайт собирается в статику, а у статики нет серверной части — отправить письмо
# самому сайту нечем. Поэтому заявку принимает внешний сервис.
# Получателя (ваш Zoho-адрес) укажите в кабинете web3forms.com.
NUXT_PUBLIC_FORM_MODE=web3forms
NUXT_PUBLIC_WEB3FORMS_KEY=

# ── Режим 2: server (если сайт переедет на Node — Vercel, Netlify, VPS) ─────
# Тогда заявки уходят напрямую через ваш Zoho, без посредников.
# Поставьте NUXT_PUBLIC_FORM_MODE=server и заполните всё ниже.
#
# ВАЖНО про пароль: если в Zoho включена двухфакторная аутентификация (а она
# должна быть включена), обычный пароль от почты НЕ подойдёт. Нужен отдельный
# «app password»: Zoho Mail → My Account → Security → App Passwords.
#
# Датацентр выбирайте по стране аккаунта:
#   Австралия → smtp.zoho.com.au
#   Европа    → smtp.zoho.eu
#   США       → smtp.zoho.com
NUXT_SMTP_HOST=smtp.zoho.com.au
NUXT_SMTP_PORT=465
NUXT_SMTP_USER=
NUXT_SMTP_PASS=
NUXT_LEAD_RECIPIENT=

# ════════════════════════════════════════════════════════════════════════════
#  АНАЛИТИКА
# ════════════════════════════════════════════════════════════════════════════
# Идентификатор потока Google Analytics 4 (вида G-XXXXXXXXXX).
# Пока пусто — скрипт не грузится и локальные заходы не портят статистику.
NUXT_PUBLIC_GA_ID=
